# DiscoveryX — environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.

# --- LLM (DeepSeek is the only provider) ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# --- async queue ---
REDIS_URL=redis://localhost:6379/0

# --- security ---
RBAC_ENABLED=true
DLP_ENABLED=true
# Dev convenience: allow the caller to declare a role via the X-Role header.
ALLOW_HEADER_ROLE=true
# Optional admin API key (X-API-Key) that maps to the admin role.
ADMIN_API_KEY=

# --- RAG ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=5

# --- app ---
ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- frontend (build-time) ---
VITE_API_BASE=http://localhost:8000
